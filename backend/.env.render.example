# =============================================================================
# 24TradeX — Render.com environment variables
# =============================================================================
# Copy each variable into: Render Dashboard → Your Web Service → Environment
# Do NOT commit real secrets to git. Use Render's "Secret" type for keys/passwords.
# =============================================================================

# --- Core ---
DEBUG=False
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-50-char-random-secret
JWT_SECRET=replace-with-another-random-secret

# Namecheap domain + Render hostname (update tradex.onrender.com if yours differs)
ALLOWED_HOSTS=s24tx.com,www.s24tx.com,tradex.onrender.com
SITE_URL=https://s24tx.com

# --- SQLite (requires Render persistent disk mounted at /var/data) ---
DB_ENGINE=django.db.backends.sqlite3
DATABASE_PATH=/var/data/db.sqlite3
MEDIA_ROOT=/var/data/media

# --- HTTPS / cookies (Render proxy) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Must match SITE_URL origins (comma-separated, include https://)
CSRF_TRUSTED_ORIGINS=https://s24tx.com,https://www.s24tx.com,https://tradex.onrender.com
CORS_ALLOWED_ORIGINS=https://s24tx.com,https://www.s24tx.com,https://tradex.onrender.com
CORS_ALLOW_ALL_ORIGINS=False

# --- Gunicorn (optional) ---
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# --- Email (optional — console backend logs only) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# --- Render build/runtime (set in render.yaml or dashboard) ---
# PYTHON_VERSION=3.12.7
# NODE_VERSION=22.12.0
