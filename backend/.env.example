# Render production:
# DATABASE_PATH=/var/data/db.sqlite3
# MEDIA_ROOT=/var/data/media

# ---------------------------------------------------------------------------
# Security (production / Render)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_TRUSTED_ORIGINS=https://s24tx.com,https://www.s24tx.com,https://your-app.onrender.com
CORS_ALLOWED_ORIGINS=https://s24tx.com,https://www.s24tx.com,https://your-app.onrender.com
CORS_ALLOW_ALL_ORIGINS=False

# ---------------------------------------------------------------------------
# Render admin bootstrap (create superuser on deploy — set in Render only)
# ---------------------------------------------------------------------------
# RENDER_ADMIN_EMAIL=admin@example.com
# RENDER_ADMIN_PASSWORD=change-me-secure-password
# RENDER_ADMIN_USERNAME=S24tx
# RENDER_ADMIN_FULL_NAME=Admin

# ---------------------------------------------------------------------------
# Render / build (optional on Render dashboard)
# ---------------------------------------------------------------------------
PYTHON_VERSION=3.12.7
NODE_VERSION=22.12.0
GUNICORN_WORKERS=1
GUNICORN_TIMEOUT=120

# ---------------------------------------------------------------------------
# Email / SMTP — signup OTP (add these on Render + local backend/.env)
# ---------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=24tradexinfo@gmail.com
# Gmail App Password (16 chars). Spaces are OK — stripped automatically. Not your login password.
EMAIL_HOST_PASSWORD=your-gmail-app-password-here
DEFAULT_FROM_EMAIL=24tradexinfo@gmail.com

# Signup OTP
SIGNUP_OTP_EXPIRY_MINUTES=10
SIGNUP_OTP_RESEND_COOLDOWN_SECONDS=60
SIGNUP_OTP_MAX_ATTEMPTS=5

# Forgot password OTP
PASSWORD_RESET_OTP_EXPIRY_MINUTES=15
PASSWORD_RESET_OTP_RESEND_COOLDOWN_SECONDS=60
