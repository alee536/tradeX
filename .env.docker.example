# Copy to .env.docker for local docker compose overrides (optional)
# cp .env.docker.example .env.docker

DEBUG=True
SECRET_KEY=docker-dev-secret-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_PATH=/app/backend/tradex/db.sqlite3
SITE_URL=http://localhost:5173

# Copy email block into backend/.env (docker-compose loads it via env_file)
